# QuestIDE AI provider settings
# Use any OpenAI-compatible provider.

# OpenAI
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Groq example:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b

# OpenRouter example:
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=meta-llama/llama-3.3-8b-instruct:free

# DeepSeek example:
# AI_BASE_URL=https://api.deepseek.com/v1
# AI_MODEL=deepseek-chat

# Ollama example (local, no paid API key):
# AI_API_KEY=ollama
# AI_BASE_URL=http://host.docker.internal:11434/v1
# AI_MODEL=llama3.1

AI_TEMPERATURE=0
AI_TOP_P=1
AI_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=30

# Do not change this when using Docker Compose.
# Compose overrides it with the internal Piston service hostname.
PISTON_URL=http://localhost:2000

ALLOWED_ORIGINS=http://localhost:3000
